# Set these locally in .env. Never send secrets in chat or commit .env.
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
# Set true only after binding the actual receiving account to this SlipOK branch in LINE LIFF.
SLIPOK_RECEIVER_CONFIGURED=false
# SCB bank code from SlipOK guide
RECEIVER_BANK=014
# Place the shop's real Mae Manee QR image in assets/.
PAYMENT_QR=
# Generate a random secret with at least 32 characters. Keep stable across restarts.
DOWNLOAD_SECRET=
PORT=3000
